# DPDK cross-file for OPI3B (RK3566 / Cortex-A55).
# platform='generic' because DPDK has no RK3566 soc_* entry; A55 tuning via c_args.

[binaries]
c           = 'aarch64-linux-gnu-gcc'
cpp         = 'aarch64-linux-gnu-g++'
ar          = 'aarch64-linux-gnu-ar'
strip       = 'aarch64-linux-gnu-strip'
pkgconfig   = 'aarch64-linux-gnu-pkg-config'
pcap-config = ''

[host_machine]
system     = 'linux'
cpu_family = 'aarch64'
cpu        = 'armv8-a'
endian     = 'little'

[properties]
platform = 'generic'

[built-in options]
c_args      = ['-mcpu=cortex-a55']
cpp_args    = ['-mcpu=cortex-a55']
c_link_args = []
