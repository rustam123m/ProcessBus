diff --git a/lib/eal/include/rte_arm_dma.h b/lib/eal/include/rte_arm_dma.h
new file mode 100644
index 0000000000..0a7395a0c0
--- /dev/null
+++ b/lib/eal/include/rte_arm_dma.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright(c) 2026 ProcessBus contributors
+ *
+ * Cache-maintenance helpers for non-coherent DMA on aarch64.
+ *
+ * Active only when RTE_ARM64_NONCOHERENT_DMA is defined (set by the
+ * meson option `noncoherent_dma=true`). On x86 and on aarch64 platforms
+ * with hardware-coherent PCIe these helpers compile to no-ops.
+ *
+ * Mirror of arch/arm64/mm/dma-mapping.c in the kernel: the kernel emits
+ * `dc cvac` (clean) before TX and `dc ivac` / `dc civac` (invalidate) before
+ * RX; we replicate this for DPDK userspace fast-paths whose descriptor and
+ * packet-buffer accesses are otherwise assumed to land in coherent memory.
+ *
+ * Header-only by design so PMDs that are built as shared libraries do not
+ * pick up an unresolved EAL global. Cache-line size comes from CTR_EL0,
+ * which is architecturally invariant — read once and cached per TU.
+ */
+#ifndef _RTE_ARM_DMA_H_
+#define _RTE_ARM_DMA_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(RTE_ARM64_NONCOHERENT_DMA) && defined(RTE_ARCH_ARM64)
+
+static inline unsigned int
+rte_arm_dcache_line_size(void)
+{
+	/* CTR_EL0.DminLine[19:16] = log2(min D-cache line size in 4-byte
+	 * words). The register is architecturally invariant for the life
+	 * of the process; cache the result on the first call. The static
+	 * is per-TU but every TU computes the same value.
+	 */
+	static unsigned int cached;
+	unsigned int v = cached;
+	if (__builtin_expect(v == 0, 0)) {
+		uint64_t ctr;
+		__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+		v = 4u << ((ctr >> 16) & 0xfu);
+		cached = v;
+	}
+	return v;
+}
+
+static inline void
+rte_arm_dma_clean(const void *addr, size_t len)
+{
+	uintptr_t step  = rte_arm_dcache_line_size();
+	uintptr_t start = (uintptr_t)addr & ~(step - 1);
+	uintptr_t end   = (uintptr_t)addr + len;
+	for (uintptr_t p = start; p < end; p += step)
+		__asm__ volatile("dc cvac, %0" :: "r"(p) : "memory");
+}
+
+/* Clean+invalidate. We always use civac (not ivac) because the caller may
+ * have dirty cache lines covering neighbouring data within the same line
+ * (e.g. a refilled RX descriptor sharing a 64-byte line with the descriptor
+ * being consumed). civac writes back any dirty bytes before invalidating,
+ * preserving them; ivac would silently drop them.
+ */
+static inline void
+rte_arm_dma_invalidate(const void *addr, size_t len)
+{
+	uintptr_t step  = rte_arm_dcache_line_size();
+	uintptr_t start = (uintptr_t)addr & ~(step - 1);
+	uintptr_t end   = (uintptr_t)addr + len;
+	for (uintptr_t p = start; p < end; p += step)
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+}
+
+static inline void
+rte_arm_dma_dsb(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Convenience: prepare a buffer to be read by a DMA-mastering device. */
+static inline void
+rte_arm_dma_for_device(const void *addr, size_t len)
+{
+	rte_arm_dma_clean(addr, len);
+	rte_arm_dma_dsb();
+}
+
+/* Convenience: prepare a buffer (already written by the device) to be read
+ * by the CPU.
+ */
+static inline void
+rte_arm_dma_for_cpu(const void *addr, size_t len)
+{
+	rte_arm_dma_dsb();
+	rte_arm_dma_invalidate(addr, len);
+}
+
+#else /* coherent or non-aarch64 — all helpers are no-ops */
+
+static inline void rte_arm_dma_clean(const void *a, size_t l)      { (void)a; (void)l; }
+static inline void rte_arm_dma_invalidate(const void *a, size_t l) { (void)a; (void)l; }
+static inline void rte_arm_dma_dsb(void)                           { }
+static inline void rte_arm_dma_for_device(const void *a, size_t l) { (void)a; (void)l; }
+static inline void rte_arm_dma_for_cpu(const void *a, size_t l)    { (void)a; (void)l; }
+
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _RTE_ARM_DMA_H_ */
